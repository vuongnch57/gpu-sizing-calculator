// Cloudflare Workers config: serves the built static site from dist/ (no server code).
// https://developers.cloudflare.com/workers/static-assets/
{
  "name": "gpu-sizing-calculator",
  "compatibility_date": "2026-10-01",
  "build": {
    // Runs before every `wrangler deploy`, so Workers Builds works without a separate build command.
    "command": "npm run build",
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
